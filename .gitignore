# ============================================================
# NEXO Landing Page Creator v3.0 - .gitignore
# ============================================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Environment variables
.env
.env.local
.env.*.local

# Database
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Logs
logs/
*.log

# Previews and generated content
nexo-lp-web/dist/
previews/
generated/
output/

# Mined templates
mined-templates/

# Uploads
uploads/
tmp/
temp/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Git worktrees
.worktrees/
*.swo
*~

# Test coverage
coverage/
.nyc_output/

# Build artifacts
dist/
build/
*.tgz
*.zip

# PM2
.pm2/
ecosystem.config.js.local

# Screenshot worker output
screenshots/
.worktrees/

# Playwright MCP / local test artifacts
.playwright-mcp/
.superpowers/
e2e/test-results/
e2e/playwright-report/

# brain-sync runtime state
.brain/.pending-commits
.brain/.pending-commits.inflight
.brain/.sync.lock

# Security — Kimi session cookies (never commit)
kimi-cookies.json
cookies.json
nexo-lp-server/services/luna/kimi-cookies.json

# Python
__pycache__/
*.pyc

# Local env backups
.env.bak*
.env.*.bak

# Backups (dot, dash, any suffix)
*.bak
*.bak.*
*.bak-*
*.bak2*
*.bak2.*

# Template migration data bundle
nexo-lp-creator/template-migration/
template-migration/
